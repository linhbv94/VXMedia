{
  "name": "vxmedia",
  "version": "1.2.9",
  "description": "Ứng dụng desktop cá nhân siêu nhẹ, đa nền tảng (Windows 11+ & macOS Apple Silicon), phục vụ duyệt và chọn lọc ảnh tốc độ cao, đồng thời phát video và âm thanh với khả năng kiểm soát phím tắt chuẩn xác và tính năng lặp đoạn A–B Loop kèm hạ/tăng âm thích ứng (Adaptive Audio Fade).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check_settings_ui.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri_sdk.mjs",
    "version:set": "node scripts/set_version.mjs",
    "release:check": "node scripts/validate_release.mjs",
    "test:updates": "node --test scripts/test_updates.mjs scripts/test_release.mjs scripts/test_release_automation.mjs",
    "test:playback": "node scripts/test_playback_browser.mjs"
  },
  "bugs": {
    "url": "https://github.com/linhbv94/VXMedia/issues"
  },
  "homepage": "https://github.com/linhbv94/VXMedia#readme",
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^1.52.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
