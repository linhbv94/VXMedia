{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "VXMedia",
  "version": "1.2.6",
  "identifier": "com.vxmedia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; connect-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "VXMedia",
        "width": 1200,
        "height": 800,
        "minWidth": 280,
        "minHeight": 180,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "ogg",
          "aac",
          "m4a",
          "wma",
          "aiff"
        ],
        "name": "Audio Files",
        "description": "Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp4",
          "mkv",
          "webm",
          "mov",
          "avi",
          "m4v"
        ],
        "name": "Video Files",
        "description": "Video File",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "webp",
          "gif",
          "svg",
          "bmp",
          "ico",
          "avif"
        ],
        "name": "Image Files",
        "description": "Image File",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Documents",
        "description": "PDF Document",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMDFBMzhFMjQ1MzA1OTMKUldTVEJWTWtqcU1CckZCQ2FwcXkrUWZjYitFUU5CVi9tSWVhQ2RkdFRRZldzcFVpTmh4VmVGcU0K",
      "endpoints": [
        "https://github.com/linhbv94/VXMedia/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
